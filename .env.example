# Read explicitly with: python -m opsyne serve --env-file .env
# Empty API key disables real LLM calls; deterministic collection and the demo still work.
OPENAI_API_KEY=
OPSYNE_DAILY_LLM_CALLS=20
OPSYNE_AUTO_INVESTIGATE=false

# Optional distinct bearer credentials named by CheckConfig.auth_env / Capability.auth_env.
# Register only the variable name in the UI/API; keep its value out of logs and JSON bodies.
OPSYNE_HTTP_CHECK_TOKEN=
OPSYNE_HTTP_OPERATION_TOKEN=

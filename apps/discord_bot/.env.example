# Load these explicitly in the Bot process. This app never reads the product's .env.
DISCORD_APPLICATION_ID=replace_with_numeric_application_id
DISCORD_PUBLIC_KEY=replace_with_64_hex_characters
DISCORD_GUILD_ID=replace_with_numeric_guild_id
DISCORD_CHANNEL_IDS=replace_with_numeric_channel_id
DISCORD_INGEST_TOKEN=replace_with_random_secret_at_least_32_characters
DISCORD_BOT_TOKEN=replace_with_bot_token_for_delivery_only
DISCORD_STATE_DIR=.local/discord

# Proposed bridge, not an existing product API. Keep both empty until integrated.
DISCORD_CONTROL_BRIDGE_URL=
DISCORD_CONTROL_BRIDGE_TOKEN=
